# quebracho/x402 0.4 marks the whole HttpFacilitator constructor deprecated by
# a misplaced docblock; only its $seller argument is. Facilitators::http()
# never passes one.
parameters:
	ignoreErrors:
		-
			message: '#^Call to deprecated method __construct\(\) of class Quebracho\\X402\\HttpFacilitator#'
			count: 1
			path: src/Facilitators.php
		# The deprecated Buyer is built by hand by its callers (new Buyer(...)),
		# so nothing can inject the stop switch: it looks the service up, or a
		# paused site would go on buying through it.
		-
			message: '#^\\Drupal calls should be avoided in classes, use dependency injection instead$#'
			count: 2
			path: src/Buyer.php
