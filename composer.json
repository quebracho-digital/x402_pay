{
  "name": "drupal/x402_pay",
  "description": "HTTP 402 (x402) micropayments in USDC on Arc: charge for any Drupal response, settled by Circle or by the site itself.",
  "type": "drupal-module",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": "^8.3",
    "drupal/key": "^1.18",
    "ext-gmp": "*",
    "ext-sodium": "*",
    "league/html-to-markdown": "^5.1",
    "quebracho/x402": "@dev",
    "symfony/psr-http-message-bridge": "^6.4 || ^7.0",
    "guzzlehttp/psr7": "^2.6"
  },
  "require-dev": {
    "drupal/markdownify": "^1.2"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../quebracho-x402-mcp/packages/x402",
      "options": {
        "symlink": true
      }
    }
  ]
}
